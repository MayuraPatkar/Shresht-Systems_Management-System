{
  "name": "shresht-systems-management-system",
  "version": "4.4.0",
  "description": "Shresht Systems Management System (SSMS) is a comprehensive ERP platform for managing customers, quotations, invoices, inventory, payments, reporting, and overall business operations.",
  "main": "dist/main.js",
  "scripts": {
    "dev:css": "tailwindcss -i ./public/css/input.css -o ./public/css/tailwind.css --watch",
    "dev:ts": "tsc --watch",
    "dev:public": "tsc -p tsconfig.public.json --watch",
    "dev:electron": "wait-on dist/main.js && electron .",
    "dev": "concurrently -k -s none --names \"TS,CSS,PUBLIC,APP\" -c \"blue,yellow,green,magenta\" \"npm run dev:ts\" \"npm run dev:css\" \"npm run dev:public\" \"npm run dev:electron\"",
    "build:ts": "tsc",
    "build:public": "tsc -p tsconfig.public.json",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/tailwind.css --minify",
    "build": "npm run build:css && npm run build:ts && npm run build:public",
    "electron": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "dist:publish": "npm run build && electron-builder --win --publish always",
    "start": "node dist/server.js",
    "test": "vitest run",
    "backup": "node dist/utils/backup.js",
    "migrate": "node dist/utils/migrate.js",
    "logs": "tail -f logs/app.log",
    "clean": "rimraf dist logs uploads backups"
  },
  "keywords": [],
  "author": "Mayura Patkar, Souvik Poddar",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "ejs": "^7.0.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-validator": "^7.3.2",
    "googleapis": "^189.0.0",
    "helmet": "^8.3.0",
    "moment": "^2.31.0",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "puppeteer": "^25.16.0",
    "winston": "^3.19.0"
  },
  "optionalDependencies": {
    "keytar": "npm:null@^7.10.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MayuraPatkar/Shresht-Systems_Management-System.git"
  },
  "bugs": {
    "url": "https://github.com/MayuraPatkar/Shresht-Systems_Management-System/issues"
  },
  "homepage": "https://github.com/MayuraPatkar/Shresht-Systems_Management-System#readme",
  "build": {
    "appId": "com.app.SSMS",
    "productName": "SSMS",
    "asar": true,
    "asarUnpack": [
      "node_modules/mongoose/**/*",
      "node_modules/mongodb/**/*",
      "node_modules/@mongodb-js/**/*",
      "node_modules/bson/**/*",
      "node_modules/bcryptjs/**/*",
      "node_modules/puppeteer/**/*",
      "node_modules/puppeteer-core/**/*",
      "node_modules/@puppeteer/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "public/assets"
    },
    "files": [
      "**/*",
      "!backups/**",
      "!logs/**",
      "!uploads/**",
      "!.git/**",
      "!node_modules/**/.cache",
      "!**/*.md",
      "!.github/**",
      "!.env",
      "!.env.*",
      "!.port-cache"
    ],
    "extraResources": [
      {
        "from": "public/assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "win": {
      "icon": "./public/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "MayuraPatkar",
      "repo": "Shresht-Systems_Management-System",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "electron-winstaller@5.4.0": true,
    "puppeteer@24.43.1": true,
    "electron@40.10.5": true,
    "@parcel/watcher@2.5.1": true
  }
}
